{
  "name": "jelly-notify",
  "version": "3.9.1",
  "description": "API de notificações do Jellyfin para WhatsApp",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "jelly-notify": "bin/jelly-notify.js"
  },
  "files": [
    ".env.example",
    "LICENSE",
    "README.md",
    "bin/",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagchi22/jelly-notify.git"
  },
  "bugs": {
    "url": "https://github.com/wagchi22/jelly-notify/issues"
  },
  "homepage": "https://github.com/wagchi22/jelly-notify#readme",
  "keywords": [
    "jellyfin",
    "whatsapp",
    "notifications",
    "bot"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "release": "semantic-release"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "chore",
              "subject": "version releases without npm publishing (#10)",
              "release": false
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.8"
  },
  "allowScripts": {
    "puppeteer@24.38.0": true
  },
  "devDependencies": {
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^11.0.3",
    "semantic-release": "^22.0.12"
  }
}
